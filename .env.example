# Supabase (proyecto: pedir a Erick la URL/keys del proyecto ya creado)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Conexion directa a Postgres (session pooler, IPv4) - solo para scripts/db/migrate.mjs
# Ver Supabase Dashboard -> Connect -> Direct -> Session pooler
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Etapa 4 (Plan B — Blockchain, apagado por defecto en Etapa 1)
NEXT_PUBLIC_BLOCKCHAIN_ENABLED=false

# Etapa 4 — wallet de deploy de contratos (Sepolia). NUNCA commitear valores reales.
# DEPLOYER_PRIVATE_KEY: clave privada de una wallet de desarrollo fondeada con ETH de prueba.
# SEPOLIA_RPC_URL: recomendado Alchemy (alchemy.com, free tier) o el fallback publico
#   https://ethereum-sepolia-rpc.publicnode.com si no quieres crear cuenta.
DEPLOYER_PRIVATE_KEY=
SEPOLIA_RPC_URL=

# Etapa 4 — WalletConnect Cloud Project ID (gratis en cloud.reown.com),
# requerido por RainbowKit para el boton "Conectar wallet".
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Etapa 2 (IA — chatbot concierge, motor de insights)
GEMINI_API_KEY=
AI_MODE=live
